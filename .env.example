# BizWithAgents — cấu hình local (dev). Một file cho backend + realtime + build frontend.
# Mặc định nối hạ tầng chung có sẵn trên server (D19); chép thành .env rồi điền mật khẩu. Không commit .env.
# Máy chưa có hạ tầng: `make infra-up` (deploy/compose.infra.yml) rồi dùng các dòng `# compose:` bên dưới.

# ── Service ──
ENV=dev
DEBUG=true
SERVICE_PATH=bizwithagents
APP_TIMEZONE=Asia/Ho_Chi_Minh

# ── HTTP ──
HOST=0.0.0.0
PORT=8202
CORS_ALLOW_ORIGINS=["http://localhost:8201"]

# ── Logging ──
LOG_LEVEL=INFO
LOG_JSON=false
LOG_HTTP_IN=true
LOG_HTTP_OUT=true
LOG_HTTP_SLOW_MS=1000
# File YAML rule log body / header theo đường dẫn (trống = chỉ metadata)
LOG_HTTP_RULES_FILE=

# ── Postgres (psycopg3) ──
POSTGRES_RW_URL=postgresql+psycopg://<user>:<mật khẩu>@127.0.0.1:5432/bizwithagents
# compose: POSTGRES_RW_URL=postgresql+psycopg://bizwithagents:bizwithagents-dev@127.0.0.1:15432/bizwithagents

# ── Mongo — chỉ ghi log; false = tắt trace / event log / issues ──
MONGO_ENABLED=true
MONGO_RW_URL=mongodb://127.0.0.1:27017
# compose: MONGO_RW_URL=mongodb://127.0.0.1:27018
MONGO_DB_NAME=bizwithagents

# ── Redis — db 10 (test dùng db 11, stack thử db 12 — D19); mọi key có tiền tố bw: ──
REDIS_RW_URL=redis://127.0.0.1:6379/10
# compose: REDIS_RW_URL=redis://127.0.0.1:16379/10

# ── RabbitMQ — vhost bizwithagents, user bizwithagents ──
RABBITMQ_URL=amqp://bizwithagents:<mật khẩu>@127.0.0.1:5672/bizwithagents
# compose: RABBITMQ_URL=amqp://bizwithagents:bizwithagents-dev@127.0.0.1:5673/bizwithagents

# ── Auth ──
AUTH_PRIVATE_KEY_FILE=.secrets/jwt_private.pem
AUTH_PUBLIC_KEY_FILE=.secrets/jwt_public.pem
SUPERADMIN_EMAILS=superadmin@test.local
# Khoá Fernet mã hoá key LLM / credential — `make setup` tự sinh vào .env; trống ở dev = mỗi process một khoá tạm
CREDENTIAL_KEYS=
# Mật khẩu chung của user test (`bw seed-test-users`) — chỉ dev / E2E, lệnh từ chối khi ENV=prod
SEED_PASSWORD=password123
# Google OAuth — GOOGLE_CLIENT_ID trống = tắt đăng nhập Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8201/bizwithagents/api/auth/google/callback
FRONTEND_AUTH_CALLBACK_URL=http://localhost:8201/auth/callback

# ── Realtime (Node) ──
REALTIME_PORT=8203

# ── Frontend (Vite đọc file này qua envDir = gốc repo) ──
VITE_API_BASE_URL=/bizwithagents/api
VITE_WS_PATH=/bizwithagents/ws
FRONTEND_PORT=8201
