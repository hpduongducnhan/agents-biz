# Một cửa cho trình duyệt (image web). Container khởi động → envsubst thay ${WEB_PORT}, ${SERVICE_PATH},
# ${API_UPSTREAM}, ${REALTIME_UPSTREAM}, ${REAL_IP_HEADER} (NGINX_ENVSUBST_FILTER) rồi ghi vào /etc/nginx/conf.d/default.conf.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ""      close;
}

map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ""      $scheme;
}

server {
    listen ${WEB_PORT};
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    # IP thật của người dùng: Cloudflare Tunnel đặt CF-Connecting-IP; không qua Cloudflare → REAL_IP_HEADER=X-Forwarded-For
    # (không recursive → lấy hop cuối do Traefik thêm). Web chỉ nhận request từ proxy nên tin mọi nguồn.
    real_ip_header ${REAL_IP_HEADER};
    set_real_ip_from 0.0.0.0/0;
    set_real_ip_from ::/0;
    real_ip_recursive off;

    # DNS nội bộ của Docker, phân giải lại mỗi 10s — api / realtime tạo lại (IP mới) không làm web trả 502.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api_upstream http://${API_UPSTREAM};
    set $realtime_upstream http://${REALTIME_UPSTREAM};

    client_max_body_size 2m;
    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    location /${SERVICE_PATH}/api/ {
        proxy_pass $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 120s;
        proxy_buffering off;
    }

    location /${SERVICE_PATH}/ws/ {
        proxy_pass $realtime_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # File có hash trong tên (Vite) → cache vĩnh viễn; index.html luôn hỏi lại để thấy bản build mới.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Content-Type-Options nosniff always;
        try_files $uri =404;
    }

    location / {
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        try_files $uri $uri/ /index.html;
    }
}
