  "cards": [
    {
      "dot": "cyan",
      "title": "Một cửa: bw-web",
      "items": [
        "Chỉ bw-web có domain; Coolify sinh SERVICE_URL_BW_WEB",
        "/bizwithagents/api/* → bw-api:16802 · /bizwithagents/ws/* → bw-realtime:16803",
        "Không service nào publish cổng host"
      ]
    },
    {
      "dot": "amber",
      "title": "Thứ tự khởi động",
      "items": [
        "bw-api: bw migrate → exec bw api (idempotent)",
        "consumer · worker · scheduler chờ bw-api healthy; realtime không chờ ai",
        "bw-web chờ bw-api + bw-realtime healthy"
      ]
    },
    {
      "dot": "emerald",
      "title": "DB dùng chung qua IP host, khoá JWT ở env",
      "items": [
        "Postgres + Mongo: database bizwithagents, user bizwithagents · nối qua IP host:<cổng> (hạ tầng chung — D19)",
        "Redis: db index trống + key bw: · RabbitMQ: vhost bizwithagents, bw.*",
        "Khoá JWT: PEM trong env AUTH_PRIVATE_KEY / AUTH_PUBLIC_KEY · Mongo chỉ kết nối khi MONGO_ENABLED=true"
      ]
    }
